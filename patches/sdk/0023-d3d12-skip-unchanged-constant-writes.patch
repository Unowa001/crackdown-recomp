From e9fcff417db14e9384331cfffd0dfc0310be8969 Mon Sep 17 00:00:00 2001
From: Jerrod <jerrod.uno@gmail.com>
Date: Sat, 17 Oct 2026 11:23:05 +0000
Subject: [PATCH] d3d12: skip invalidation when a shader constant is rewritten
 unchanged

Every write to a float, bool/loop or fetch constant marked the matching
constant buffer stale, and fetch constant writes also dropped the texture
binding and vertex buffer residency state for those fetches, even when
the game wrote back the value the register already held. After 0021 and
0022, TextureCache::RequestTextures (17.5%) and UpdateBindings (12.5%)
were the largest parts of IssueDraw on the GPU command processor thread
in Crackdown.

- WriteRegistersFromMem (the ranged path from 0007) compares before
  copying and narrows the range to the constants that changed; nothing
  is invalidated if none did.
- WriteRegister returns early for a same-value write to a shader constant
  (constants have no other side effects in the base WriteRegister).
- gpu_skip_unchanged_constant_writes (default on) turns it off for A/B.
---
 src/graphics/d3d12/command_processor.cpp | 50 ++++++++++++++++++++++--
 1 file changed, 47 insertions(+), 3 deletions(-)

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 1a49162..f32cc26 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -33,6 +33,12 @@
 #include <rex/ui/d3d12/d3d12_presenter.h>
 #include <rex/ui/d3d12/d3d12_util.h>
 
+REXCVAR_DEFINE_BOOL(gpu_skip_unchanged_constant_writes, true, "GPU/D3D12",
+                    "Don't invalidate constant buffers, texture bindings and vertex buffer "
+                    "residency when the game rewrites a shader constant with the value it "
+                    "already has")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_BOOL(d3d12_bindless, true, "GPU/D3D12", "Use bindless resources where available")
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
@@ -1791,6 +1797,12 @@ void D3D12CommandProcessor::ShutdownContext() {
 }
 
 void D3D12CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
+  // Shader constants have no side effects besides the invalidation below.
+  if (index >= XE_GPU_REG_SHADER_CONSTANT_000_X && index <= XE_GPU_REG_SHADER_CONSTANT_LOOP_31 &&
+      register_file_->values[index] == value &&
+      REXCVAR_GET(gpu_skip_unchanged_constant_writes)) {
+    return;
+  }
   CommandProcessor::WriteRegister(index, value);
 
   if (index >= XE_GPU_REG_SHADER_CONSTANT_000_X && index <= XE_GPU_REG_SHADER_CONSTANT_511_W) {
@@ -1856,9 +1868,37 @@ void D3D12CommandProcessor::WriteRegistersFromMem(uint32_t start_index, uint32_t
     return (usage_map[last_word] & last_mask) != 0;
   };
 
+  // Copies the constants in and narrows [start_index, end_index] to the ones
+  // whose value changed; false if none did. Games rewrite the same constants
+  // for many draws, and each write here invalidates bindings.
+  auto copy_constants = [&]() -> bool {
+    uint32_t* dest = register_file_->values + start_index;
+    if (!REXCVAR_GET(gpu_skip_unchanged_constant_writes)) {
+      memory::copy_and_swap(dest, base, num_registers);
+      return true;
+    }
+    uint32_t first = 0;
+    while (first < num_registers && dest[first] == rex::byte_swap(base[first])) {
+      ++first;
+    }
+    if (first == num_registers) {
+      return false;
+    }
+    uint32_t last = num_registers - 1;
+    while (last > first && dest[last] == rex::byte_swap(base[last])) {
+      --last;
+    }
+    memory::copy_and_swap(dest + first, base + first, last - first + 1);
+    end_index = start_index + last;
+    start_index += first;
+    return true;
+  };
+
   if (start_index >= XE_GPU_REG_SHADER_CONSTANT_000_X &&
       end_index <= XE_GPU_REG_SHADER_CONSTANT_511_W) {
-    memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
+    if (!copy_constants()) {
+      return;
+    }
     if (frame_open_) {
       uint32_t first_float_constant = (start_index - XE_GPU_REG_SHADER_CONSTANT_000_X) >> 2;
       uint32_t last_float_constant = (end_index - XE_GPU_REG_SHADER_CONSTANT_000_X) >> 2;
@@ -1884,14 +1924,18 @@ void D3D12CommandProcessor::WriteRegistersFromMem(uint32_t start_index, uint32_t
 
   if (start_index >= XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 &&
       end_index <= XE_GPU_REG_SHADER_CONSTANT_LOOP_31) {
-    memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
+    if (!copy_constants()) {
+      return;
+    }
     cbuffer_binding_bool_loop_.up_to_date = false;
     return;
   }
 
   if (start_index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
       end_index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5) {
-    memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
+    if (!copy_constants()) {
+      return;
+    }
     cbuffer_binding_fetch_.up_to_date = false;
     uint32_t first_fetch_dword = start_index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0;
     uint32_t last_fetch_dword = end_index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0;
-- 
2.43.0

