From 4835369903329f55ce5fe30814f2866fba5250d8 Mon Sep 17 00:00:00 2001
From: Jerrod <jerrod.uno@gmail.com>
Date: Sat, 17 Oct 2026 16:35:02 +0000
Subject: [PATCH] gpu: skip unchanged per-draw render target ownership and
 sampler work

---
 .../rex/graphics/d3d12/command_processor.h    |  9 ++++
 .../graphics/pipeline/render_target/cache.h   | 11 ++++
 src/graphics/d3d12/command_processor.cpp      | 25 +++++++++-
 src/graphics/d3d12/render_target_cache.cpp    | 16 ++++++
 src/graphics/pipeline/render_target/cache.cpp | 50 +++++++++++++++++--
 5 files changed, 104 insertions(+), 7 deletions(-)

diff --git a/include/rex/graphics/d3d12/command_processor.h b/include/rex/graphics/d3d12/command_processor.h
index 75785b3..44fb140 100644
--- a/include/rex/graphics/d3d12/command_processor.h
+++ b/include/rex/graphics/d3d12/command_processor.h
@@ -801,6 +801,15 @@ class D3D12CommandProcessor : public CommandProcessor {
   std::vector<D3D12TextureCache::TextureSRVKey> current_texture_srv_keys_pixel_;
   std::vector<D3D12TextureCache::SamplerParameters> current_samplers_vertex_;
   std::vector<D3D12TextureCache::SamplerParameters> current_samplers_pixel_;
+  // Incremented on every fetch constant write, for skipping the recomputation
+  // of current_samplers_#_ when nothing they depend on has changed.
+  uint64_t fetch_constants_generation_ = 1;
+  size_t sampler_memo_layout_uid_vertex_ = 0;
+  size_t sampler_memo_layout_uid_pixel_ = 0;
+  uint64_t sampler_memo_fetch_generation_vertex_ = 0;
+  uint64_t sampler_memo_fetch_generation_pixel_ = 0;
+  int32_t sampler_memo_anisotropic_override_vertex_ = 0;
+  int32_t sampler_memo_anisotropic_override_pixel_ = 0;
   std::vector<uint32_t> current_sampler_bindless_indices_vertex_;
   std::vector<uint32_t> current_sampler_bindless_indices_pixel_;
 
diff --git a/include/rex/graphics/pipeline/render_target/cache.h b/include/rex/graphics/pipeline/render_target/cache.h
index 3bbd52e..0c8d7ea 100644
--- a/include/rex/graphics/pipeline/render_target/cache.h
+++ b/include/rex/graphics/pipeline/render_target/cache.h
@@ -171,6 +171,9 @@ class RenderTargetCache {
 
   virtual void BeginFrame();
 
+  // The gpu_draw_state_memo cvar: skip repeated per-draw work.
+  static bool IsDrawStateMemoEnabled();
+
   virtual bool Update(bool is_rasterization_done, reg::RB_DEPTHCONTROL normalized_depth_control,
                       uint32_t normalized_color_mask, const Shader& vertex_shader);
 
@@ -660,6 +663,14 @@ class RenderTargetCache {
   // since standard containers use dynamic allocation for elements, though
   // changes to this throughout a frame are pretty rare.
   std::map<uint32_t, OwnershipRange> ownership_ranges_;
+  // Incremented on every change of ownership_ranges_.
+  uint64_t ownership_generation_ = 1;
+  // The ownership changes done by the last Update that did them, in the EDRAM
+  // base order, and ownership_generation_ right after them.
+  uint64_t ownership_memo_generation_ = 0;
+  uint32_t ownership_memo_count_ = 0;
+  RenderTargetKey ownership_memo_keys_[1 + xenos::kMaxColorRenderTargets];
+  uint32_t ownership_memo_lengths_[1 + xenos::kMaxColorRenderTargets];
 
   // Render targets actually used by the draw call with the last successful
   // update. 0 is depth, color starting from 1, nullptr if not bound.
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 0118205..0370251 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -1820,6 +1820,7 @@ void D3D12CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
   } else if (index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
              index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5) {
     cbuffer_binding_fetch_.up_to_date = false;
+    ++fetch_constants_generation_;
     if (texture_cache_ != nullptr) {
       texture_cache_->TextureFetchConstantWritten((index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0) /
                                                   6);
@@ -1898,6 +1899,7 @@ void D3D12CommandProcessor::WriteRegistersFromMem(uint32_t start_index, uint32_t
       end_index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5) {
     memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
     cbuffer_binding_fetch_.up_to_date = false;
+    ++fetch_constants_generation_;
     uint32_t first_fetch_dword = start_index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0;
     uint32_t last_fetch_dword = end_index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0;
     if (texture_cache_) {
@@ -3422,6 +3424,7 @@ bool D3D12CommandProcessor::BeginSubmission(bool is_guest_command) {
     cbuffer_binding_float_pixel_.up_to_date = false;
     cbuffer_binding_bool_loop_.up_to_date = false;
     cbuffer_binding_fetch_.up_to_date = false;
+    ++fetch_constants_generation_;
     current_shared_memory_binding_is_uav_.reset();
     if (bindless_resources_used_) {
       cbuffer_binding_descriptor_indices_vertex_.up_to_date = false;
@@ -4417,7 +4420,15 @@ bool D3D12CommandProcessor::UpdateBindings(const D3D12Shader* vertex_shader,
       vertex_shader->GetSamplerBindingsAfterTranslation();
   size_t texture_count_vertex = textures_vertex.size();
   size_t sampler_count_vertex = samplers_vertex.size();
-  if (sampler_count_vertex) {
+  // Sampler parameters only depend on the binding layout, the fetch constants
+  // and anisotropic_override - skip recomputing them if none changed.
+  bool sampler_memo_enabled = RenderTargetCache::IsDrawStateMemoEnabled();
+  int32_t anisotropic_override_value = REXCVAR_GET(anisotropic_override);
+  bool samplers_vertex_unchanged =
+      sampler_memo_enabled && sampler_memo_layout_uid_vertex_ == sampler_layout_uid_vertex &&
+      sampler_memo_fetch_generation_vertex_ == fetch_constants_generation_ &&
+      sampler_memo_anisotropic_override_vertex_ == anisotropic_override_value;
+  if (sampler_count_vertex && !samplers_vertex_unchanged) {
     if (current_sampler_layout_uid_vertex_ != sampler_layout_uid_vertex) {
       current_sampler_layout_uid_vertex_ = sampler_layout_uid_vertex;
       cbuffer_binding_descriptor_indices_vertex_.up_to_date = false;
@@ -4434,6 +4445,9 @@ bool D3D12CommandProcessor::UpdateBindings(const D3D12Shader* vertex_shader,
         current_samplers_vertex_[i] = parameters;
       }
     }
+    sampler_memo_layout_uid_vertex_ = sampler_layout_uid_vertex;
+    sampler_memo_fetch_generation_vertex_ = fetch_constants_generation_;
+    sampler_memo_anisotropic_override_vertex_ = anisotropic_override_value;
   }
 
   // Get textures and samplers used by the pixel shader, check if the last used
@@ -4449,7 +4463,11 @@ bool D3D12CommandProcessor::UpdateBindings(const D3D12Shader* vertex_shader,
     texture_count_pixel = textures_pixel->size();
     samplers_pixel = &pixel_shader->GetSamplerBindingsAfterTranslation();
     sampler_count_pixel = samplers_pixel->size();
-    if (sampler_count_pixel) {
+    bool samplers_pixel_unchanged =
+        sampler_memo_enabled && sampler_memo_layout_uid_pixel_ == sampler_layout_uid_pixel &&
+        sampler_memo_fetch_generation_pixel_ == fetch_constants_generation_ &&
+        sampler_memo_anisotropic_override_pixel_ == anisotropic_override_value;
+    if (sampler_count_pixel && !samplers_pixel_unchanged) {
       if (current_sampler_layout_uid_pixel_ != sampler_layout_uid_pixel) {
         current_sampler_layout_uid_pixel_ = sampler_layout_uid_pixel;
         cbuffer_binding_descriptor_indices_pixel_.up_to_date = false;
@@ -4466,6 +4484,9 @@ bool D3D12CommandProcessor::UpdateBindings(const D3D12Shader* vertex_shader,
           bindful_samplers_written_pixel_ = false;
         }
       }
+      sampler_memo_layout_uid_pixel_ = sampler_layout_uid_pixel;
+      sampler_memo_fetch_generation_pixel_ = fetch_constants_generation_;
+      sampler_memo_anisotropic_override_pixel_ = anisotropic_override_value;
     }
   } else {
     texture_layout_uid_pixel = PipelineCache::kLayoutUIDEmpty;
diff --git a/src/graphics/d3d12/render_target_cache.cpp b/src/graphics/d3d12/render_target_cache.cpp
index dd321a5..b3e0517 100644
--- a/src/graphics/d3d12/render_target_cache.cpp
+++ b/src/graphics/d3d12/render_target_cache.cpp
@@ -3800,6 +3800,22 @@ void D3D12RenderTargetCache::PerformTransfersAndResolveClears(
     const Transfer::Rectangle* resolve_clear_rectangle) {
   assert_true(GetPath() == Path::kHostRenderTargets);
 
+  // The usual case for a draw: no transfers and no clear - nothing below would
+  // record anything.
+  if (IsDrawStateMemoEnabled() &&
+      !(render_target_resolve_clear_values && resolve_clear_rectangle)) {
+    bool any_transfers = false;
+    for (uint32_t i = 0; i < render_target_count; ++i) {
+      if (render_targets[i] && !render_target_transfers[i].empty()) {
+        any_transfers = true;
+        break;
+      }
+    }
+    if (!any_transfers) {
+      return;
+    }
+  }
+
   const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
   ID3D12Device* device = provider.GetDevice();
   uint64_t current_submission = command_processor_.GetCurrentSubmission();
diff --git a/src/graphics/pipeline/render_target/cache.cpp b/src/graphics/pipeline/render_target/cache.cpp
index 953c5fd..a118549 100644
--- a/src/graphics/pipeline/render_target/cache.cpp
+++ b/src/graphics/pipeline/render_target/cache.cpp
@@ -37,6 +37,11 @@ REXCVAR_DEFINE_BOOL(execute_unclipped_draw_vs_on_cpu_for_psi_render_backend, tru
 REXCVAR_DEFINE_BOOL(snorm16_render_target_full_range, true, "GPU",
                     "Use full range for SNORM16 render targets");
 
+REXCVAR_DEFINE_BOOL(gpu_draw_state_memo, true, "GPU",
+                    "Skip per-draw render target ownership and sampler work when the "
+                    "state it depends on hasn't changed since the previous draw")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_BOOL(direct_host_resolve, true, "GPU",
                     "Resolve from host render targets directly to shared memory when possible")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
@@ -341,6 +346,7 @@ void RenderTargetCache::InitializeCommon() {
 }
 
 void RenderTargetCache::DestroyAllRenderTargets(bool shutting_down) {
+  ++ownership_generation_;
   ownership_ranges_.clear();
   if (!shutting_down) {
     ownership_ranges_.emplace(std::piecewise_construct, std::forward_as_tuple(uint32_t(0)),
@@ -397,6 +403,10 @@ void RenderTargetCache::BeginFrame() {
   ResetAccumulatedRenderTargets();
 }
 
+bool RenderTargetCache::IsDrawStateMemoEnabled() {
+  return REXCVAR_GET(gpu_draw_state_memo);
+}
+
 bool RenderTargetCache::Update(bool is_rasterization_done,
                                reg::RB_DEPTHCONTROL normalized_depth_control,
                                uint32_t normalized_color_mask, const Shader& vertex_shader) {
@@ -683,11 +693,38 @@ bool RenderTargetCache::Update(bool is_rasterization_done,
   // draw with whatever contents currently are in the render target in this
   // case).
 
-  for (uint32_t i = 0; i < edram_bases_sorted_count; ++i) {
-    const std::pair<uint32_t, uint32_t>& rt_base_index = edram_bases_sorted[i];
-    uint32_t rt_bit_index = rt_base_index.second;
-    ChangeOwnership(rt_keys[rt_bit_index], 0, rt_lengths_tiles[i],
-                    interlock_barrier_only ? nullptr : &last_update_transfers_[rt_bit_index]);
+  // The ranges claimed below don't overlap (each is clamped to the next base),
+  // so if the previous update claimed exactly the same ones and nothing has
+  // changed the ownership since, claiming them again would be a no-op with no
+  // transfers - skip the map walks then.
+  bool ownership_memo_hit = false;
+  if (!interlock_barrier_only && REXCVAR_GET(gpu_draw_state_memo) &&
+      ownership_memo_generation_ == ownership_generation_ &&
+      ownership_memo_count_ == edram_bases_sorted_count) {
+    ownership_memo_hit = true;
+    for (uint32_t i = 0; i < edram_bases_sorted_count; ++i) {
+      if (ownership_memo_keys_[i] != rt_keys[edram_bases_sorted[i].second] ||
+          ownership_memo_lengths_[i] != rt_lengths_tiles[i]) {
+        ownership_memo_hit = false;
+        break;
+      }
+    }
+  }
+  if (!ownership_memo_hit) {
+    for (uint32_t i = 0; i < edram_bases_sorted_count; ++i) {
+      const std::pair<uint32_t, uint32_t>& rt_base_index = edram_bases_sorted[i];
+      uint32_t rt_bit_index = rt_base_index.second;
+      ChangeOwnership(rt_keys[rt_bit_index], 0, rt_lengths_tiles[i],
+                      interlock_barrier_only ? nullptr : &last_update_transfers_[rt_bit_index]);
+    }
+    if (!interlock_barrier_only) {
+      for (uint32_t i = 0; i < edram_bases_sorted_count; ++i) {
+        ownership_memo_keys_[i] = rt_keys[edram_bases_sorted[i].second];
+        ownership_memo_lengths_[i] = rt_lengths_tiles[i];
+      }
+      ownership_memo_count_ = edram_bases_sorted_count;
+      ownership_memo_generation_ = ownership_generation_;
+    }
   }
 
   if (interlock_barrier_only) {
@@ -1127,6 +1164,7 @@ bool RenderTargetCache::PrepareHostRenderTargetsResolveClear(
 void RenderTargetCache::PixelShaderInterlockFullEdramBarrierPlaced() {
   assert_true(GetPath() == Path::kPixelShaderInterlock);
   // Clear ownership - any overlap of data written before the barrier is safe.
+  ++ownership_generation_;
   OwnershipRange empty_range(xenos::kEdramTileCount, RenderTargetKey(), RenderTargetKey(),
                              RenderTargetKey());
   if (ownership_ranges_.size() == 1) {
@@ -1264,6 +1302,7 @@ void RenderTargetCache::ChangeOwnership(RenderTargetKey dest, uint32_t start_til
       if (it_pre->second.end_tiles > extent_start &&
           !it_pre->second.IsOwnedBy(dest, host_depth_encoding_different)) {
         // Different render target overlapping the range - split the head.
+        ++ownership_generation_;
         ownership_ranges_.emplace(extent_start, it_pre->second);
         it_pre->second.end_tiles = extent_start;
         // Let the next loop do the transfer and needed merging and splitting
@@ -1343,6 +1382,7 @@ void RenderTargetCache::ChangeOwnership(RenderTargetKey dest, uint32_t start_til
         }
       }
       // Claim the current range.
+      ++ownership_generation_;
       it->second.render_target = dest;
       if (host_depth_encoding_different) {
         it->second.GetHostDepthRenderTarget(dest.GetDepthFormat()) = dest;
-- 
2.43.0

