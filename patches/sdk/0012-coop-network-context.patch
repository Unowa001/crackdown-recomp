--- /dev/null
+++ b/include/rex/system/coop_network_context.h
@@ -0,0 +1,42 @@
+#pragma once
+#include <array>
+#include <map>
+#include <mutex>
+#include <vector>
+#include <rex/cvar.h>
+#include <rex/system/coop_network_abi.h>
+REXCVAR_DECLARE(bool, net_trace);
+namespace rex::system {
+// IPv4 values in this interface are host-order; wire bytes are converted only
+// at the sockaddr/XNADDR boundary. Each process owns one context per runtime.
+struct CoopEndpoint { uint32_t ip; uint16_t port; };
+struct CoopPeer {
+  uint32_t token;
+  XNADDR address{};
+  XNKID session{};
+  uint32_t ip;
+  int32_t offset;
+  bool connected=false;
+};
+class CoopNetworkContext {
+ public:
+  void Initialize();
+  bool enabled=false;
+  uint32_t bind_ip=0, advertise_ip=0;
+  int32_t port_offset=0;
+  XNADDR local{};
+  std::mutex mutex;
+  std::map<std::array<uint8_t,8>,XNKEY> keys;
+  std::vector<CoopPeer> peers;
+  CoopEndpoint BindEndpoint(CoopEndpoint guest);
+  std::vector<CoopEndpoint> Destinations(CoopEndpoint guest);
+  CoopEndpoint Source(CoopEndpoint native);
+  uint32_t Resolve(const XNADDR& address,const XNKID& session);
+  bool Reverse(uint32_t token,XNADDR* address,XNKID* session);
+  bool Connect(uint32_t token);
+  uint32_t Status(uint32_t token);
+  bool Forget(uint32_t token);
+ private:
+  std::once_flag init_once_;
+};
+} // namespace rex::system
