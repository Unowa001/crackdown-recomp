From 8618525b9cc4ef5f360b6cec8d6e1894ebd3badf Mon Sep 17 00:00:00 2001
From: Jerrod <jerrod.uno@gmail.com>
Date: Tue, 13 Oct 2026 20:22:14 -0400
Subject: [PATCH] socket-readiness

Guest socket/select wrapper path 0x829295E0. Source pinned xam_net.cpp WSAWaitForMultipleEvents/select and netplay xam_net.cc readiness behavior (WSAResetEvent re-signals when IsEventSelectPending, xam_net.cc:664-680). Native Windows WSAEventSelect retains SDK XEvent; POSIX explicitly unsupported for event-select. Fix WSA millisecond-to-relative-100ns timeout, any/all and returned index. EventSelect resets the event before re-arming: Crackdown re-arms each poll (TCP ev0 + VDP ev1, lr 0x82461B60/0x82461B80, wait lr 0x82461BB8) and imports neither WSAResetEvent nor WSAEnumNetworkEvents; without the reset WSAWaitForMultipleEvents returned 0 ~900k times and the VDP socket was never read, so both System Link instances timed out in the co-op load (out/coop-live 2026-10-13). Authors: Codex, Claude.
---
 include/rex/system/xevent.h          |  1 +
 include/rex/system/xsocket.h         |  3 +++
 src/kernel/xam/xam_net.cpp           | 38 ++++++++++++++++++++++++----
 src/system/CMakeLists.txt            |  1 +
 src/system/coop_socket_readiness.cpp | 25 ++++++++++++++++++
 5 files changed, 63 insertions(+), 5 deletions(-)
 create mode 100644 src/system/coop_socket_readiness.cpp

diff --git a/include/rex/system/xevent.h b/include/rex/system/xevent.h
index e81df52..91ea4d8 100644
--- a/include/rex/system/xevent.h
+++ b/include/rex/system/xevent.h
@@ -32,6 +32,7 @@ class XEvent : public XObject {
   void Initialize(bool manual_reset, bool initial_state);
   void InitializeNative(void* native_ptr, X_DISPATCH_HEADER* header);
 
+  void* socket_event_handle() const { return event_->native_handle(); }
   void Query(uint32_t* out_type, uint32_t* out_state);
 
   int32_t Set(uint32_t priority_increment, bool wait);
diff --git a/include/rex/system/xsocket.h b/include/rex/system/xsocket.h
index a1b4443..efb9e6c 100644
--- a/include/rex/system/xsocket.h
+++ b/include/rex/system/xsocket.h
@@ -12,6 +12,7 @@
 
 #include <cstring>
 #include <queue>
+#include <rex/system/xevent.h>
 
 #include <rex/math.h>
 #include <rex/system/xobject.h>
@@ -106,6 +107,7 @@ class XSocket : public XObject {
   X_STATUS Bind(N_XSOCKADDR_IN* name, int name_len);
   X_STATUS Listen(int backlog);
   object_ref<XSocket> Accept(N_XSOCKADDR* name, int* name_len);
+  int EventSelect(object_ref<XEvent> event, uint32_t mask);
   int Shutdown(int how);
 
   int Recv(uint8_t* buf, uint32_t buf_len, uint32_t flags);
@@ -139,6 +141,7 @@ class XSocket : public XObject {
   bool bound_ = false;  // Explicitly bound to an IP address?
   uint16_t bound_port_ = 0;
 
+  object_ref<XEvent> readiness_event_;
   bool broadcast_socket_ = false;
 
   std::unique_ptr<rex::thread::Event> event_;
diff --git a/src/kernel/xam/xam_net.cpp b/src/kernel/xam/xam_net.cpp
index 714c629..85dbc5a 100644
--- a/src/kernel/xam/xam_net.cpp
+++ b/src/kernel/xam/xam_net.cpp
@@ -332,11 +332,11 @@ u32 NetDll_WSAWaitForMultipleEvents_entry(u32 num_events, mapped_u32 events, u32
     return ~0u;
   }
 
-  uint64_t timeout_wait = (uint64_t)timeout;
+  uint64_t timeout_wait = uint64_t(-int64_t(uint32_t(timeout))*10000);
 
   X_STATUS result = 0;
   do {
-    result = xboxkrnl::xeNtWaitForMultipleObjectsEx(num_events, events, wait_all, 1, alertable,
+    result = xboxkrnl::xeNtWaitForMultipleObjectsEx(num_events, events, wait_all?0:1, 1, alertable,
                                                     timeout != -1 ? &timeout_wait : nullptr);
   } while (result == X_STATUS_ALERTED);
 
@@ -345,7 +345,7 @@ u32 NetDll_WSAWaitForMultipleEvents_entry(u32 num_events, mapped_u32 events, u32
     XThread::SetLastError(error);
     return ~0u;
   }
-  return 0;
+  return result;
 }
 
 u32 NetDll_WSACreateEvent_entry() {
@@ -702,7 +702,7 @@ struct host_set {
   object_ref<XSocket> sockets[64];
 
   void Load(const x_fd_set* guest_set) {
-    assert_true(guest_set->fd_count < 64);
+    assert_true(guest_set->fd_count <= 64);
     this->count = guest_set->fd_count;
     for (uint32_t i = 0; i < this->count; ++i) {
       auto socket_handle = static_cast<X_HANDLE>(guest_set->fd_array[i]);
@@ -747,6 +747,17 @@ struct host_set {
 i32 NetDll_select_entry(i32 caller, i32 nfds, ppc_ptr_t<x_fd_set> readfds,
                         ppc_ptr_t<x_fd_set> writefds, ppc_ptr_t<x_fd_set> exceptfds,
                         mapped_void timeout_ptr) {
+  for (const auto* set : {readfds.host_address(),writefds.host_address(),exceptfds.host_address()}) {
+    if (!set) continue;
+    if (set->fd_count>64) { XThread::SetLastError(10022); return -1; }
+    for (uint32_t i=0;i<set->fd_count;i++) {
+      auto socket=REX_KERNEL_OBJECTS()->LookupObject<XSocket>(set->fd_array[i]);
+      if (!socket) { XThread::SetLastError(10038); return -1; }
+#if !REX_PLATFORM_WIN32
+      nfds=std::max(int32_t(nfds),int32_t(socket->native_handle()+1));
+#endif
+    }
+  }
   host_set host_readfds = {};
   fd_set native_readfds = {};
   if (readfds) {
@@ -776,6 +787,14 @@ i32 NetDll_select_entry(i32 caller, i32 nfds, ppc_ptr_t<x_fd_set> readfds,
   }
   int ret = select(nfds, readfds ? &native_readfds : nullptr, writefds ? &native_writefds : nullptr,
                    exceptfds ? &native_exceptfds : nullptr, timeout_in);
+  if (ret<0) {
+#if REX_PLATFORM_WIN32
+    XThread::SetLastError(WSAGetLastError());
+#else
+    XThread::SetLastError(10022);
+#endif
+    return -1;
+  }
   if (readfds) {
     host_readfds.UpdateFrom(&native_readfds);
     host_readfds.Store(readfds);
@@ -925,7 +944,16 @@ REX_EXPORT_STUB(__imp__NetDll_UpnpSearchCreate);
 REX_EXPORT_STUB(__imp__NetDll_UpnpSearchGetDevices);
 REX_EXPORT_STUB(__imp__NetDll_UpnpStartup);
 REX_EXPORT_STUB(__imp__NetDll_WSACancelOverlappedIO);
-REX_EXPORT_STUB(__imp__NetDll_WSAEventSelect);
+namespace rex::kernel::xam {
+u32 NetDll_WSAEventSelect_entry(u32 caller,u32 handle,u32 event_handle,u32 mask) {
+  auto socket=REX_KERNEL_OBJECTS()->LookupObject<XSocket>(handle);
+  if (!socket) { XThread::SetLastError(10038); return -1; }
+  auto event=event_handle?REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle):object_ref<XEvent>{};
+  if (event_handle && !event) { XThread::SetLastError(10006); return -1; }
+  return socket->EventSelect(std::move(event),mask);
+}
+}
+REX_EXPORT(__imp__NetDll_WSAEventSelect,rex::kernel::xam::NetDll_WSAEventSelect_entry)
 REX_EXPORT_STUB(__imp__NetDll_WSAGetOverlappedResult);
 REX_EXPORT_STUB(__imp__NetDll_WSARecv);
 REX_EXPORT_STUB(__imp__NetDll_WSASend);
