   bool EndGuestOcclusionQuery(uint32_t sample_count_address,
                               xenos::xe_gpu_depth_sample_counts* sample_counts);
   bool AcquireOcclusionQueryIndex(uint32_t& host_index_out);
-  void DisableHostOcclusionQueries();
+  void AbandonActiveOcclusionQuery();
+  void BeginOcclusionQuerySegment();
+  void EndOcclusionQuerySegment();
+  // Writes the results of pending queries whose submissions have completed;
+  // with await_submission, first waits for that submission.
+  void WritePendingOcclusionResults(uint64_t await_submission = 0);
   uint64_t NormalizeOcclusionSamples(uint64_t samples) const;
   void WriteGuestOcclusionResult(xenos::xe_gpu_depth_sample_counts* sample_counts,
                                  uint64_t samples);
@@ -654,11 +661,25 @@ class D3D12CommandProcessor : public CommandProcessor {
   uint64_t* occlusion_query_readback_mapping_ = nullptr;
   uint32_t occlusion_query_cursor_ = 0;
   bool occlusion_query_resources_available_ = false;
+  // A guest query can span submissions, but a host query can't span command
+  // lists: each submission gets its own host query (segment), and the guest
+  // result is the sum of the segments.
   struct ActiveOcclusionQuery {
     uint32_t sample_count_address = 0;
-    uint32_t host_index = UINT32_MAX;
+    uint32_t host_index = UINT32_MAX;  // the segment open in this submission
+    bool host_open = false;
+    std::vector<uint32_t> ended_segments;  // resolved into the readback buffer
     bool valid = false;
   } active_occlusion_query_;
+  // Ended guest queries waiting for their submission to complete. Results are
+  // written to guest memory then, like the real GPU writing them when it gets
+  // there; until then the guest sees the query as not finished.
+  struct PendingOcclusionQuery {
+    uint32_t sample_count_address;
+    std::vector<uint32_t> host_indices;
+    uint64_t submission;
+  };
+  std::deque<PendingOcclusionQuery> pending_occlusion_queries_;
   struct VertexBufferState {
     uint32_t address = UINT32_MAX;
     uint32_t size = UINT32_MAX;
