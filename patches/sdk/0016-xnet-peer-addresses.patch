From fb6ec6fa63ec4198867494eeb8ae5050a36ce46d Mon Sep 17 00:00:00 2001
From: Jerrod <jerrod.uno@gmail.com>
Date: Tue, 13 Oct 2026 20:21:27 -0400
Subject: [PATCH] xnet-peer-addresses

Guest 0x82462758 XnAddrToInAddr, 0x8243BA58 InAddrToXnAddr, 0x8241C69C connect, 0x824628BC status. Disassembly generated .102/.100/.108/.36.cpp per plan; fork ef09406 xam_net.cc:925 by-value dword signature. Reverse uses configured/supplied peer data; no FindPlayer HTTP. Validation: runtime trace pending; connected means transport association, not proof of remote gameplay. Author: Codex.
---
 src/kernel/CMakeLists.txt               |  1 +
 src/kernel/xam/coop_xnet_connection.cpp | 16 +++++++
 src/kernel/xam/xam_net.cpp              | 57 ++++++++++++-------------
 3 files changed, 44 insertions(+), 30 deletions(-)
 create mode 100644 src/kernel/xam/coop_xnet_connection.cpp

diff --git a/src/kernel/CMakeLists.txt b/src/kernel/CMakeLists.txt
index 317d14f..70b8f84 100644
--- a/src/kernel/CMakeLists.txt
+++ b/src/kernel/CMakeLists.txt
@@ -11,6 +11,7 @@ set(REXKERNEL_SOURCES
     xam/xam_content_device.cpp
     xam/xam_debug.cpp
     xam/xam_enum.cpp
+    xam/coop_xnet_connection.cpp
     xam/xam_info.cpp
     xam/xam_input.cpp
     xam/xam_locale.cpp
diff --git a/src/kernel/xam/coop_xnet_connection.cpp b/src/kernel/xam/coop_xnet_connection.cpp
new file mode 100644
index 0000000..3d0252f
--- /dev/null
+++ b/src/kernel/xam/coop_xnet_connection.cpp
@@ -0,0 +1,16 @@
+// Serverless XNet connection association. Socket readiness determines delivery.
+#include <rex/hook.h>
+namespace rex::kernel::xam {
+u32 NetDll_XNetConnect_entry(u32 caller,u32 token) {
+  return REX_KERNEL_STATE()->coop_network().Connect(token)?0:10049;
+}
+u32 NetDll_XNetGetConnectStatus_entry(u32 caller,u32 token) {
+  return REX_KERNEL_STATE()->coop_network().Status(token);
+}
+u32 NetDll_XNetUnregisterInAddr_entry(u32 caller,u32 token) {
+  return REX_KERNEL_STATE()->coop_network().Forget(token)?0:10049;
+}
+}
+REX_EXPORT(__imp__NetDll_XNetConnect,rex::kernel::xam::NetDll_XNetConnect_entry)
+REX_EXPORT(__imp__NetDll_XNetGetConnectStatus,rex::kernel::xam::NetDll_XNetGetConnectStatus_entry)
+REX_EXPORT(__imp__NetDll_XNetUnregisterInAddr,rex::kernel::xam::NetDll_XNetUnregisterInAddr_entry)
diff --git a/src/kernel/xam/xam_net.cpp b/src/kernel/xam/xam_net.cpp
index 433a899..714c629 100644
--- a/src/kernel/xam/xam_net.cpp
+++ b/src/kernel/xam/xam_net.cpp
@@ -408,27 +408,11 @@ struct XnAddrStatus {
 };
 
 u32 NetDll_XNetGetTitleXnAddr_entry(u32 caller, ppc_ptr_t<XNADDR> addr_ptr) {
-  // Just return a loopback address atm.
-  addr_ptr->ina.s_addr = htonl(INADDR_LOOPBACK);
-  addr_ptr->inaOnline.s_addr = 0;
-  addr_ptr->wPortOnline = 0;
-
-  // TODO(gibbed): A proper mac address.
-  // RakNet's 360 version appears to depend on abEnet to create "random" 64-bit
-  // numbers. A zero value will cause RakPeer::Startup to fail. This causes
-  // 58411436 to crash on startup.
-  // The 360-specific code is scrubbed from the RakNet repo, but there's still
-  // traces of what it's doing which match the game code.
-  // https://github.com/facebookarchive/RakNet/blob/master/Source/RakPeer.cpp#L382
-  // https://github.com/facebookarchive/RakNet/blob/master/Source/RakPeer.cpp#L4527
-  // https://github.com/facebookarchive/RakNet/blob/master/Source/RakPeer.cpp#L4467
-  // "Mac address is a poor solution because you can't have multiple connections
-  // from the same system"
-  std::memset(addr_ptr->abEnet, 0xCC, 6);
-
-  std::memset(addr_ptr->abOnline, 0, 20);
-
-  return XnAddrStatus::XNET_GET_XNADDR_STATIC;
+  if (!addr_ptr) return 1;
+  auto& net=REX_KERNEL_STATE()->coop_network();
+  if (!net.enabled) { addr_ptr.Zero(); return 1; }
+  *addr_ptr=net.local;
+  return XnAddrStatus::XNET_GET_XNADDR_STATIC | XnAddrStatus::XNET_GET_XNADDR_ETHERNET;
 }
 
 u32 NetDll_XNetGetDebugXnAddr_entry(u32 caller, ppc_ptr_t<XNADDR> addr_ptr) {
@@ -445,27 +429,40 @@ u32 NetDll_XNetXnAddrToMachineId_entry(u32 caller, ppc_ptr_t<XNADDR> addr_ptr, m
 
 void NetDll_XNetInAddrToString_entry(u32 caller, u32 in_addr, mapped_string string_out,
                                      u32 string_size) {
-  rex::string::copy_truncating(string_out, "666.666.666.666", string_size);
+  const uint32_t value=in_addr;
+  const auto text=fmt::format("{}.{}.{}.{}",value>>24,(value>>16)&255,(value>>8)&255,value&255);
+  rex::string::copy_truncating(string_out,text,string_size);
 }
 
 // This converts a XNet address to an IN_ADDR. The IN_ADDR is used for
 // subsequent socket calls (like a handle to a XNet address)
 u32 NetDll_XNetXnAddrToInAddr_entry(u32 caller, ppc_ptr_t<XNADDR> xn_addr, mapped_void xid,
                                     mapped_void in_addr) {
-  return 1;
+  if (!xn_addr || !xid || !in_addr) return 10014;
+  const auto& session=*reinterpret_cast<const XNKID*>(xid.host_address());
+  auto& net=REX_KERNEL_STATE()->coop_network();
+  uint32_t token=net.Resolve(*xn_addr,session);
+  if (!token) return 10049;
+  memory::store_and_swap<uint32_t>(in_addr,token);
+  if (REXCVAR_GET(net_trace)) REXLOG_INFO("net XNetXnAddrToInAddr token={:08X} MAC={:02X}{:02X}..",token,xn_addr->abEnet[0],xn_addr->abEnet[1]);
+  return 0;
 }
 
 // Does the reverse of the above.
 // FIXME: Arguments may not be correct.
-u32 NetDll_XNetInAddrToXnAddr_entry(u32 caller, mapped_void in_addr, ppc_ptr_t<XNADDR> xn_addr,
+u32 NetDll_XNetInAddrToXnAddr_entry(u32 caller, u32 in_addr, ppc_ptr_t<XNADDR> xn_addr,
                                     mapped_void xid) {
-  return 1;
+  if (!xn_addr || !xid) return 10014;
+  auto& net=REX_KERNEL_STATE()->coop_network();
+  bool found=net.Reverse(in_addr,xn_addr,reinterpret_cast<XNKID*>(xid.host_address()));
+  if (REXCVAR_GET(net_trace)) REXLOG_INFO("net XNetInAddrToXnAddr token={:08X} found={}",uint32_t(in_addr),found);
+  return found?0:10049;
 }
 
 // https://www.google.com/patents/WO2008112448A1?cl=en
 // Reserves a port for use by system link
 u32 NetDll_XNetSetSystemLinkPort_entry(u32 caller, u32 port) {
-  return 1;
+  return 0;
 }
 
