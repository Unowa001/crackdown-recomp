diff --git a/src/system/coop_socket_readiness.cpp b/src/system/coop_socket_readiness.cpp
new file mode 100644
index 0000000..1948f6e
--- /dev/null
+++ b/src/system/coop_socket_readiness.cpp
@@ -0,0 +1,25 @@
+// Native Winsock readiness uses the SDK event's retained manual-reset HANDLE.
+#include <rex/system/xsocket.h>
+#include <rex/system/xthread.h>
+#if REX_PLATFORM_WIN32
+#include <winsock2.h>
+#endif
+namespace rex::system {
+int XSocket::EventSelect(object_ref<XEvent> event,uint32_t mask) {
+  if ((mask&~0x3fu) || (mask && !event)) { XThread::SetLastError(10022); return -1; }
+#if REX_PLATFORM_WIN32
+  // Crackdown re-arms WSAEventSelect every poll and never calls WSAResetEvent or
+  // WSAEnumNetworkEvents (not imported), so a stale signal on its first event
+  // won every WSAWaitForMultipleEvents and its VDP socket was never read
+  // (out/coop-live 2026-10-13). Reset first: Winsock signals again at once if
+  // the condition (e.g. FD_READ) still holds, so the event tracks readiness.
+  if (event) ResetEvent(event->socket_event_handle());
+  int ret=WSAEventSelect(native_handle_,event?event->socket_event_handle():nullptr,mask);
+  if (ret<0) { XThread::SetLastError(WSAGetLastError()); return ret; }
+  readiness_event_=std::move(event); return 0;
+#else
+  // Do not report success without providing wakeups on unsupported hosts.
+  XThread::SetLastError(10045); return -1;
+#endif
+}
+}
