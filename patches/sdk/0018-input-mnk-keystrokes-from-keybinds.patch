From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jerrod <jerrod.uno@gmail.com>
Date: Thu, 15 Oct 2026 15:40:00 -0400
Subject: [PATCH] input: MnK driver reports keystrokes for its keybinds

MnkInputDriver::GetDeviceKeystroke only drained keystroke_queue_, and
nothing ever filled it (EnqueueKeystroke has no callers), so every
XInputGetKeystroke on the keyboard device returned X_ERROR_EMPTY.
Crackdown reads its menus through keystrokes (guest 0x827437C0, the
game's XInputGetKeystroke -> XamInputGetKeystrokeEx), so with mnk_mode on
the "Press Start" screen ignored the keyboard while WASD still worked in
game through XInputGetState (Reddit beta report, 2026-10-14).

Build a keyfield from the same binds GetDeviceState uses (buttons,
triggers, both sticks' key directions) and emit up/down edges and
repeats the way the SDL driver does from its pad state: same bit
layout, VK_PAD_* table, ups before downs, 400 ms delay and 100 ms repeat.
Unlike the SDL driver, every pending up/down is reported before a repeat,
so a held, repeating key can't starve another key's release (Codex review
2026-10-15); releasing a key only stops the repeat if it is the repeating one.
Mouse look makes no keystrokes. The button binds move into a shared
BoundButtons() helper so both paths read one list.
---
 include/rex/input/mnk/mnk_input_driver.h |   9 +
 src/input/mnk/mnk_input_driver.cpp       | 201 ++++++++++++++++++-----
 2 files changed, 173 insertions(+), 37 deletions(-)

diff --git a/include/rex/input/mnk/mnk_input_driver.h b/include/rex/input/mnk/mnk_input_driver.h
index c8751b7..910e7cc 100644
--- a/include/rex/input/mnk/mnk_input_driver.h
+++ b/include/rex/input/mnk/mnk_input_driver.h
@@ -102,6 +102,15 @@ class MnkInputDriver final : public InputDriver,
   // Keystroke queue
   std::queue<X_INPUT_KEYSTROKE> keystroke_queue_;
 
+  // Keystrokes made from the binds (GetDeviceKeystroke), under state_mutex_.
+  enum class RepeatState { kIdle, kWaiting, kRepeating };
+  static constexpr uint32_t kRepeatDelayMs = 400;
+  static constexpr uint32_t kRepeatRateMs = 100;
+  uint64_t keystroke_keys_ = 0;  // keyfield bits last reported down
+  RepeatState repeat_state_ = RepeatState::kIdle;
+  uint8_t repeat_index_ = 0;
+  uint32_t repeat_time_ = 0;
+
   // Packet number incremented on state change
   uint32_t packet_number_ = 0;
 };
diff --git a/src/input/mnk/mnk_input_driver.cpp b/src/input/mnk/mnk_input_driver.cpp
index 3f9422d..e8ffb0b 100644
--- a/src/input/mnk/mnk_input_driver.cpp
+++ b/src/input/mnk/mnk_input_driver.cpp
@@ -17,7 +17,10 @@
 #include <rex/ui/virtual_key.h>
 #include <rex/ui/window.h>
 
+#include <rex/chrono/clock.h>
+
 #include <algorithm>
+#include <array>
 #include <cmath>
 #include <cstdlib>
 #include <cstring>
@@ -219,6 +222,41 @@ static bool IsBindPressed(const bool (&key_down)[256], const std::string& cvar_v
   return false;
 }
 
+static uint16_t BoundButtons(const bool (&key_down)[256]) {
+  uint16_t buttons = 0;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_a)))
+    buttons |= X_INPUT_GAMEPAD_A;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_b)))
+    buttons |= X_INPUT_GAMEPAD_B;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_x)))
+    buttons |= X_INPUT_GAMEPAD_X;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_y)))
+    buttons |= X_INPUT_GAMEPAD_Y;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_left_shoulder)))
+    buttons |= X_INPUT_GAMEPAD_LEFT_SHOULDER;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_right_shoulder)))
+    buttons |= X_INPUT_GAMEPAD_RIGHT_SHOULDER;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_lstick_press)))
+    buttons |= X_INPUT_GAMEPAD_LEFT_THUMB;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_rstick_press)))
+    buttons |= X_INPUT_GAMEPAD_RIGHT_THUMB;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_back)))
+    buttons |= X_INPUT_GAMEPAD_BACK;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_start)))
+    buttons |= X_INPUT_GAMEPAD_START;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_guide)))
+    buttons |= X_INPUT_GAMEPAD_GUIDE;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_dpad_up)))
+    buttons |= X_INPUT_GAMEPAD_DPAD_UP;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_dpad_down)))
+    buttons |= X_INPUT_GAMEPAD_DPAD_DOWN;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_dpad_left)))
+    buttons |= X_INPUT_GAMEPAD_DPAD_LEFT;
+  if (IsBindPressed(key_down, REXCVAR_GET(keybind_dpad_right)))
+    buttons |= X_INPUT_GAMEPAD_DPAD_RIGHT;
+  return buttons;
+}
+
 void MnkInputDriver::EnumerateDevices(std::vector<DeviceInfo>& out) {
   // Disabled means no device at all, so it never occupies a guest user slot.
   if (!IsEnabled()) {
@@ -274,37 +312,7 @@ X_RESULT MnkInputDriver::GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) {
 
   std::lock_guard lock(state_mutex_);
 
-  uint16_t buttons = 0;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_a)))
-    buttons |= X_INPUT_GAMEPAD_A;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_b)))
-    buttons |= X_INPUT_GAMEPAD_B;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_x)))
-    buttons |= X_INPUT_GAMEPAD_X;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_y)))
-    buttons |= X_INPUT_GAMEPAD_Y;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_left_shoulder)))
-    buttons |= X_INPUT_GAMEPAD_LEFT_SHOULDER;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_right_shoulder)))
-    buttons |= X_INPUT_GAMEPAD_RIGHT_SHOULDER;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_lstick_press)))
-    buttons |= X_INPUT_GAMEPAD_LEFT_THUMB;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_rstick_press)))
-    buttons |= X_INPUT_GAMEPAD_RIGHT_THUMB;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_back)))
-    buttons |= X_INPUT_GAMEPAD_BACK;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_start)))
-    buttons |= X_INPUT_GAMEPAD_START;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_guide)))
-    buttons |= X_INPUT_GAMEPAD_GUIDE;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_up)))
-    buttons |= X_INPUT_GAMEPAD_DPAD_UP;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_down)))
-    buttons |= X_INPUT_GAMEPAD_DPAD_DOWN;
-  if (IsBindPressed(key_down_, REXCVAR_GET(keybind_dpad_left)))
-    buttons |= X_INPUT_GAMEPAD_DPAD_LEFT;
