+  // vD is also an input (words outside the packed slot are kept), and the
+  // cases below write vD piecewise while still reading vB. For an in-place
+  // pack (vD == vB, e.g. vpkd3d128 v0,v0,5,2,2) those writes would clobber
+  // source bits not yet read -- the float16_4 x sign among them -- so read a
+  // copy instead.
+  const bool aliased = ctx.insn.operands[0] == ctx.insn.operands[1];
+  if (aliased)
+    ctx.println("\t{{ PPCVRegister vPkSrc = {};", ctx.v(ctx.insn.operands[1]));
+  const std::string src = aliased ? std::string("vPkSrc") : ctx.v(ctx.insn.operands[1]);
   switch (ctx.insn.operands[2]) {
     case 0:  // D3D color
