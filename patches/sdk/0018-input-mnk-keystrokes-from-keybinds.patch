+  uint16_t buttons = BoundButtons(key_down_);
 
   uint8_t lt = IsBindPressed(key_down_, REXCVAR_GET(keybind_left_trigger)) ? 0xFF : 0;
   uint8_t rt = IsBindPressed(key_down_, REXCVAR_GET(keybind_right_trigger)) ? 0xFF : 0;
@@ -369,20 +377,139 @@ X_RESULT MnkInputDriver::SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibr
   return X_ERROR_SUCCESS;
 }
 
+// Bit layout of the keyfield, shared with the SDL driver: 0-15 the XInput
+// button bits, 16-17 the triggers, 18-25 left stick directions, 26-33 right
+// stick directions (up, down, right, left, then the four diagonals).
+static constexpr std::array<rex::ui::VirtualKey, 34> kKeystrokeVk = {
+    rex::ui::VirtualKey::kXInputPadDpadUp,      rex::ui::VirtualKey::kXInputPadDpadDown,
+    rex::ui::VirtualKey::kXInputPadDpadLeft,    rex::ui::VirtualKey::kXInputPadDpadRight,
+    rex::ui::VirtualKey::kXInputPadStart,       rex::ui::VirtualKey::kXInputPadBack,
+    rex::ui::VirtualKey::kXInputPadLThumbPress, rex::ui::VirtualKey::kXInputPadRThumbPress,
+    rex::ui::VirtualKey::kXInputPadLShoulder,   rex::ui::VirtualKey::kXInputPadRShoulder,
+    rex::ui::VirtualKey::kNone, /* Guide has no VK */
+    rex::ui::VirtualKey::kNone, /* Unknown */
+    rex::ui::VirtualKey::kXInputPadA,           rex::ui::VirtualKey::kXInputPadB,
+    rex::ui::VirtualKey::kXInputPadX,           rex::ui::VirtualKey::kXInputPadY,
+    rex::ui::VirtualKey::kXInputPadLTrigger,    rex::ui::VirtualKey::kXInputPadRTrigger,
+    rex::ui::VirtualKey::kXInputPadLThumbUp,    rex::ui::VirtualKey::kXInputPadLThumbDown,
+    rex::ui::VirtualKey::kXInputPadLThumbRight, rex::ui::VirtualKey::kXInputPadLThumbLeft,
+    rex::ui::VirtualKey::kXInputPadLThumbUpLeft,    rex::ui::VirtualKey::kXInputPadLThumbUpRight,
+    rex::ui::VirtualKey::kXInputPadLThumbDownRight, rex::ui::VirtualKey::kXInputPadLThumbDownLeft,
+    rex::ui::VirtualKey::kXInputPadRThumbUp,    rex::ui::VirtualKey::kXInputPadRThumbDown,
+    rex::ui::VirtualKey::kXInputPadRThumbRight, rex::ui::VirtualKey::kXInputPadRThumbLeft,
+    rex::ui::VirtualKey::kXInputPadRThumbUpLeft,    rex::ui::VirtualKey::kXInputPadRThumbUpRight,
+    rex::ui::VirtualKey::kXInputPadRThumbDownRight, rex::ui::VirtualKey::kXInputPadRThumbDownLeft,
+};
+
+// Stick direction bits from the stick's bound keys. A diagonal replaces its
+// two cardinals, as XInput reports it.
+static uint64_t StickKeyfield(bool u, bool d, bool r, bool l, int shift) {
+  if (u && d) u = d = false;
+  if (l && r) l = r = false;
+  uint64_t f = 0;
+  if (u && l) { u = l = false; f |= uint64_t(1) << (22 + shift); }
+  if (u && r) { u = r = false; f |= uint64_t(1) << (23 + shift); }
+  if (d && r) { d = r = false; f |= uint64_t(1) << (24 + shift); }
+  if (d && l) { d = l = false; f |= uint64_t(1) << (25 + shift); }
+  f |= uint64_t(u) << (18 + shift);
+  f |= uint64_t(d) << (19 + shift);
+  f |= uint64_t(r) << (20 + shift);
+  f |= uint64_t(l) << (21 + shift);
+  return f;
+}
+
+// XInputGetKeystroke for the bound keys, made from the same binds as
+// GetDeviceState: titles that read menus through keystrokes (Crackdown's
+// "Press Start" screen, for one) otherwise never see the keyboard. Mouse look
+// makes no keystrokes, like a pad's right stick under the threshold would not.
 X_RESULT MnkInputDriver::GetDeviceKeystroke(DeviceId id, uint32_t flags,
                                             X_INPUT_KEYSTROKE* out_keystroke) {
   if (!IsEnabled() || id != kMnkDevice) {
     return X_ERROR_DEVICE_NOT_CONNECTED;
   }
-  std::lock_guard lock(state_mutex_);
-  if (keystroke_queue_.empty()) {
-    return X_ERROR_EMPTY;
+  if (!out_keystroke) {
+    return X_ERROR_BAD_ARGUMENTS;
   }
-  if (out_keystroke) {
+  std::lock_guard lock(state_mutex_);
+  if (!keystroke_queue_.empty()) {
     *out_keystroke = keystroke_queue_.front();
+    keystroke_queue_.pop();
+    return X_ERROR_SUCCESS;
   }
-  keystroke_queue_.pop();
-  return X_ERROR_SUCCESS;
+
+  // Inactive or unfocused reads as nothing held, so held keys send their up
+  // events, as the SDL driver does.
+  uint64_t curr = 0;
+  if (is_active() && has_focus_) {
+    auto pressed = [this](const std::string& bind) { return IsBindPressed(key_down_, bind); };
+    curr = BoundButtons(key_down_);
+    curr |= uint64_t(pressed(REXCVAR_GET(keybind_left_trigger))) << 16;
+    curr |= uint64_t(pressed(REXCVAR_GET(keybind_right_trigger))) << 17;
+    curr |= StickKeyfield(pressed(REXCVAR_GET(keybind_lstick_up)),
+                          pressed(REXCVAR_GET(keybind_lstick_down)),
+                          pressed(REXCVAR_GET(keybind_lstick_right)),
+                          pressed(REXCVAR_GET(keybind_lstick_left)), 0);
+    curr |= StickKeyfield(pressed(REXCVAR_GET(keybind_rstick_up)),
+                          pressed(REXCVAR_GET(keybind_rstick_down)),
+                          pressed(REXCVAR_GET(keybind_rstick_right)),
+                          pressed(REXCVAR_GET(keybind_rstick_left)), 8);
+  }
+
+  auto fill = [out_keystroke](rex::ui::VirtualKey vk, uint16_t ks_flags) {
+    out_keystroke->virtual_key = uint16_t(vk);
+    out_keystroke->unicode = 0;
+    // InputSystem stamps the guest user this device is assigned to.
+    out_keystroke->user_index = 0;
+    out_keystroke->flags = ks_flags;
+    out_keystroke->hid_code = 0;
+  };
+
+  const auto now = rex::chrono::Clock::QueryGuestUptimeMillis();
+  // Every pending up/down goes out before any repeat: a held, repeating key
+  // must not starve another key's release or press. Ups before downs, so a
+  // stick moving from a diagonal to a cardinal releases the diagonal first.
+  const uint64_t changed = curr ^ keystroke_keys_;
+  for (int pass = 0; changed && pass < 2; ++pass) {
+    for (uint8_t i = 0; i < uint8_t(kKeystrokeVk.size()); ++i) {
+      const uint64_t bit = uint64_t(1) << i;
+      if (!(changed & bit)) {
+        continue;
+      }
+      const bool down = (curr & bit) != 0;
+      if (kKeystrokeVk[i] == rex::ui::VirtualKey::kNone) {
+        keystroke_keys_ = (keystroke_keys_ & ~bit) | (curr & bit);
+        continue;
+      }
+      if (pass == 0 && !down) {
+        keystroke_keys_ &= ~bit;
+        if (i == repeat_index_) {
+          repeat_state_ = RepeatState::kIdle;
+        }
+        fill(kKeystrokeVk[i], X_INPUT_KEYSTROKE_KEYUP);
+        return X_ERROR_SUCCESS;
+      }
+      if (pass == 1 && down) {
+        keystroke_keys_ |= bit;
+        repeat_state_ = RepeatState::kWaiting;
+        repeat_index_ = i;
+        repeat_time_ = now;
+        fill(kKeystrokeVk[i], X_INPUT_KEYSTROKE_KEYDOWN);
+        return X_ERROR_SUCCESS;
+      }
+    }
+  }
+
+  // Same repeat timing as the SDL driver, so held arrows scroll menus.
+  if (repeat_state_ == RepeatState::kWaiting && repeat_time_ + kRepeatDelayMs < now) {
+    repeat_state_ = RepeatState::kRepeating;
+  }
+  if (repeat_state_ == RepeatState::kRepeating && repeat_time_ + kRepeatRateMs < now &&
+      (curr & (uint64_t(1) << repeat_index_))) {
+    repeat_time_ = now;
+    fill(kKeystrokeVk[repeat_index_], X_INPUT_KEYSTROKE_KEYDOWN | X_INPUT_KEYSTROKE_REPEAT);
+    return X_ERROR_SUCCESS;
+  }
+  return X_ERROR_EMPTY;
 }
 
 void MnkInputDriver::EnqueueKeystroke(uint16_t vk_pad, bool down) {
