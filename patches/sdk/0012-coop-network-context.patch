diff --git a/src/system/coop_network_context.cpp b/src/system/coop_network_context.cpp
new file mode 100644
index 0000000..d5f7f38
--- /dev/null
+++ b/src/system/coop_network_context.cpp
@@ -0,0 +1,133 @@
+// Serverless transport configuration, original implementation for ReXGlue.
+#include <rex/system/coop_network_context.h>
+#include <rex/logging.h>
+#include <cstring>
+#include <random>
+#include <sstream>
+#include <stdexcept>
+REXCVAR_DEFINE_STRING(net_mode,"off","Network","off, lan or direct");
+REXCVAR_DEFINE_STRING(net_bind_ip,"127.0.0.1","Network","Explicit local IPv4 interface");
+REXCVAR_DEFINE_STRING(net_advertise_ip,"","Network","Advertised IPv4 (defaults to bind IP)");
+REXCVAR_DEFINE_STRING(net_peer_endpoints,"","Network","Comma-separated IPv4:discovery-host-port; fixed offset map for guest ports");
+REXCVAR_DEFINE_INT32(net_port_offset,0,"Network","Local host port minus guest port");
+REXCVAR_DEFINE_STRING(net_instance_id,"","Network","Diagnostic instance label");
+REXCVAR_DEFINE_BOOL(net_trace,false,"Network","Opt-in network trace (no raw keys)");
+namespace rex::system {
+namespace {
+uint32_t ParseIP(const std::string& text) {
+  std::istringstream in(text); unsigned a,b,c,d; char x,y,z,extra;
+  if (!(in>>a>>x>>b>>y>>c>>z>>d) || x!='.' || y!='.' || z!='.' ||
+      a>255 || b>255 || c>255 || d>255 || (in>>extra))
+    throw std::invalid_argument("net: invalid IPv4: "+text);
+  return (a<<24)|(b<<16)|(c<<8)|d;
+}
+uint16_t Port(uint16_t guest,int32_t offset) {
+  if (!guest) return 0; // Preserve ephemeral port selection.
+  int64_t mapped=int64_t(guest)+offset;
+  if (mapped<1 || mapped>65535) throw std::invalid_argument("net: port mapping outside 1..65535");
+  return uint16_t(mapped);
+}
+void Identity(XNADDR& out,uint32_t ip,int32_t offset) {
+  out={}; out.ina.s_addr=htonl(ip); out.wPortOnline=Port(1000,offset);
+  // Locally administered unicast MAC. The configured endpoint distinguishes
+  // two processes on one IPv4; no master service or game-packet headers.
+  out.abEnet[0]=2; out.abEnet[1]=uint8_t(ip>>16); out.abEnet[2]=uint8_t(ip>>8);
+  out.abEnet[3]=uint8_t(ip); out.abEnet[4]=uint8_t(out.wPortOnline>>8);
+  out.abEnet[5]=uint8_t(out.wPortOnline);
+}
+}
+void CoopNetworkContext::Initialize() {
+  std::call_once(init_once_,[this] {
+    const auto mode=REXCVAR_GET(net_mode);
+    if (mode!="off" && mode!="lan" && mode!="direct") throw std::invalid_argument("net_mode must be off, lan or direct");
+    enabled=mode!="off"; if (!enabled) return;
+    bind_ip=ParseIP(REXCVAR_GET(net_bind_ip));
+    advertise_ip=REXCVAR_GET(net_advertise_ip).empty()?bind_ip:ParseIP(REXCVAR_GET(net_advertise_ip));
+    if (!advertise_ip || advertise_ip==0xffffffff) throw std::invalid_argument("net: advertise IP must be unicast");
+    port_offset=REXCVAR_GET(net_port_offset);
+    Port(1002,port_offset); Identity(local,advertise_ip,port_offset);
+    std::stringstream input(REXCVAR_GET(net_peer_endpoints)); std::string item;
+    std::vector<CoopPeer> configured;
+    while (std::getline(input,item,',')) {
+      const auto colon=item.find(':');
+      if (colon==std::string::npos) throw std::invalid_argument("net: peer must be IPv4:discovery-port");
+      auto ip=ParseIP(item.substr(0,colon));
+      size_t used=0; const auto tail=item.substr(colon+1); auto p=std::stoul(tail,&used);
+      if (used!=tail.size() || p<1001 || p>65534 || !ip || ip==0xffffffff || configured.size()>=16)
+        throw std::invalid_argument("net: invalid peer endpoint");
+      CoopPeer peer{}; peer.token=0xf0000001+uint32_t(configured.size()); peer.ip=ip; peer.offset=int32_t(p)-1001;
+      Identity(peer.address,ip,peer.offset); configured.push_back(peer);
+    }
+    if (mode=="direct" && configured.empty()) throw std::invalid_argument("net: direct mode requires peers");
+    peers=std::move(configured);
+    REXLOG_INFO("net: instance={} mode={} bind={:08X} offset={} peers={}",REXCVAR_GET(net_instance_id),mode,bind_ip,port_offset,peers.size());
+  });
+}
+CoopEndpoint CoopNetworkContext::BindEndpoint(CoopEndpoint guest) {
+  if (!enabled) return guest;
+  if (!guest.ip) guest.ip=bind_ip;
+  guest.port=Port(guest.port,port_offset); return guest;
+}
+std::vector<CoopEndpoint> CoopNetworkContext::Destinations(CoopEndpoint guest) {
+  std::lock_guard lock(mutex);
+  if (!enabled) return {guest};
+  if (guest.ip==0xffffffff && !peers.empty()) {
+    std::vector<CoopEndpoint> result;
+    for (const auto& peer:peers) result.push_back({peer.ip,Port(guest.port,peer.offset)});
+    return result;
+  }
+  for (const auto& peer:peers) if (peer.token==guest.ip) return {{peer.ip,Port(guest.port,peer.offset)}};
+  // Unknown opaque addresses must never leak onto the host network.
+  if ((guest.ip&0xf0000000)==0xf0000000 && guest.ip!=0xffffffff) return {};
+  return {guest};
+}
+CoopEndpoint CoopNetworkContext::Source(CoopEndpoint native) {
+  std::lock_guard lock(mutex);
+  if (!enabled) return native;
+  for (const auto& peer:peers) {
+    int64_t guest_port=int64_t(native.port)-peer.offset;
+    if (peer.ip==native.ip && guest_port>=1000 && guest_port<=1002)
+      return {peer.token,uint16_t(guest_port)};
+  }
+  return native;
+}
+uint32_t CoopNetworkContext::Resolve(const XNADDR& address,const XNKID& session) {
+  std::lock_guard lock(mutex);
+  if (!enabled || !keys.contains(std::to_array(session.ab))) return 0;
+  for (auto& peer:peers) if (!std::memcmp(peer.address.abEnet,address.abEnet,6)) {
+    peer.address=address; peer.session=session; return peer.token;
+  }
+  // LAN addresses retain their original guest ports. Explicit peers must have
+  // a configured remote endpoint map; do not guess their offset from our own.
+  uint32_t ip=ntohl(address.ina.s_addr);
+  if (!ip || ip==0xffffffff || peers.size()>=64) return 0;
+  if (REXCVAR_GET(net_mode)=="direct") return 0;
+  CoopPeer peer{}; peer.token=0xf0000001+uint32_t(peers.size());
+  peer.address=address; peer.session=session; peer.ip=ip; peer.offset=0;
+  peers.push_back(peer); return peer.token;
+}
+bool CoopNetworkContext::Reverse(uint32_t token,XNADDR* address,XNKID* session) {
+  std::lock_guard lock(mutex);
+  for (const auto& peer:peers) if (peer.token==token) {
+    if (address) *address=peer.address;
+    if (session) *session=peer.session;
+    return true;
+  }
+  return false;
+}
+bool CoopNetworkContext::Connect(uint32_t token) {
+  std::lock_guard lock(mutex);
+  for (auto& peer:peers) if (peer.token==token) { peer.connected=true; return true; }
+  return false;
+}
+uint32_t CoopNetworkContext::Status(uint32_t token) {
+  std::lock_guard lock(mutex);
+  for (const auto& peer:peers) if (peer.token==token) return peer.connected?3:0;
+  return 0;
+}
+bool CoopNetworkContext::Forget(uint32_t token) {
+  std::lock_guard lock(mutex);
+  for (auto& peer:peers) if (peer.token==token) { peer.connected=false; peer.session={}; return true; }
+  return false;
+}
+} // namespace rex::system
