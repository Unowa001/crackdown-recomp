From ce75dbd992d2753d9d64302f05ad801684921b62 Mon Sep 17 00:00:00 2001
From: Jerrod <jerrod.uno@gmail.com>
Date: Mon, 12 Oct 2026 16:46:59 -0400
Subject: [PATCH] gpu: command processor fast paths (ranged type-0 writes, no
 per-call vector)

- ExecutePacketType0: consecutive-register packets go through
  WriteRegisterRangeFromRing, so the D3D12 backend's bulk path for shader
  constant / fetch constant ranges is used instead of one virtual
  WriteRegister per dword. Same register effects (the bulk path falls back
  to per-register writes for mixed ranges).
- CommandProcessor::WriteRegister: the GetRegisterInfo switch only runs
  when gpu debug logging is enabled (it only fed a debug message).
- SharedMemory::RequestRanges: per-thread scratch vector instead of a new
  heap allocation per call; skip the sort for a single range.

Crackdown (spawn point, idle, 1x, 60 fps cap): command processor thread
was saturated at ~51 fps; 61.5 fps (cap) after, 67 fps uncapped.
---
 src/graphics/command_processor.cpp | 15 ++++++++++++---
 src/graphics/shared_memory.cpp     | 16 ++++++++++------
 2 files changed, 22 insertions(+), 9 deletions(-)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 8a628f7..f2f64c1 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -356,7 +356,10 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
 
   // Volatile for the WAIT_REG_MEM loop.
   const_cast<volatile uint32_t&>(regs.values[index]) = value;
-  if (!regs.GetRegisterInfo(index)) {
+  // The register table lookup is a large switch run on every register write;
+  // only do it when the debug message can be logged.
+  auto* gpu_log = ::rex::GetLoggerRaw(::rex::log::gpu());
+  if (gpu_log && gpu_log->should_log(spdlog::level::debug) && !regs.GetRegisterInfo(index)) {
     REXGPU_DEBUG("GPU: Write to unknown register ({:04X} = {:08X})", index, value);
   }
 
@@ -703,10 +706,16 @@ bool CommandProcessor::ExecutePacketType0(memory::RingBuffer* reader, uint32_t p
 
   uint32_t base_index = (packet & 0x7FFF);
   uint32_t write_one_reg = (packet >> 15) & 0x1;
+  if (!write_one_reg) {
+    // Consecutive registers: one ranged write, so backends can take their
+    // bulk paths (e.g. whole shader constant ranges) instead of a virtual
+    // WriteRegister per dword.
+    WriteRegisterRangeFromRing(reader, base_index, count);
+    return true;
+  }
   for (uint32_t m = 0; m < count; m++) {
     uint32_t reg_data = reader->ReadAndSwap<uint32_t>();
-    uint32_t target_index = write_one_reg ? base_index : base_index + m;
-    WriteRegister(target_index, reg_data);
+    WriteRegister(base_index, reg_data);
   }
 
   return true;
diff --git a/src/graphics/shared_memory.cpp b/src/graphics/shared_memory.cpp
index ec0df7c..e74c278 100644
--- a/src/graphics/shared_memory.cpp
+++ b/src/graphics/shared_memory.cpp
@@ -343,8 +343,10 @@ bool SharedMemory::RequestRanges(const std::pair<uint32_t, uint32_t>* ranges, si
   }
 
   // Some texture or buffer is empty, for example - safe to draw in this case.
-  std::vector<std::pair<uint32_t, uint32_t>> merged_ranges;
-  merged_ranges.reserve(count);
+  // Per-thread scratch: this runs for every vertex buffer and texture request,
+  // so a fresh vector here was a heap allocation per call.
+  thread_local std::vector<std::pair<uint32_t, uint32_t>> merged_ranges;
+  merged_ranges.clear();
   for (size_t i = 0; i < count; ++i) {
     uint32_t start = ranges[i].first;
     uint32_t length = ranges[i].second;
@@ -362,10 +364,12 @@ bool SharedMemory::RequestRanges(const std::pair<uint32_t, uint32_t>* ranges, si
 
   SCOPE_profile_cpu_f("gpu");
 
-  std::sort(merged_ranges.begin(), merged_ranges.end(),
-            [](const std::pair<uint32_t, uint32_t>& a, const std::pair<uint32_t, uint32_t>& b) {
-              return a.first < b.first;
-            });
+  if (merged_ranges.size() > 1) {
+    std::sort(merged_ranges.begin(), merged_ranges.end(),
+              [](const std::pair<uint32_t, uint32_t>& a, const std::pair<uint32_t, uint32_t>& b) {
+                return a.first < b.first;
+              });
+  }
   size_t merged_write = 0;
   for (size_t i = 1; i < merged_ranges.size(); ++i) {
     std::pair<uint32_t, uint32_t>& range_previous = merged_ranges[merged_write];
-- 
