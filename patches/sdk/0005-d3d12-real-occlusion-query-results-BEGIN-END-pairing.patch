   if (!is_end) {
-    if (active_occlusion_query_.valid &&
-        active_occlusion_query_.sample_count_address != sample_count_addr) {
-      DisableHostOcclusionQueries();
-      return write_fallback_result();
-    }
+    AbandonActiveOcclusionQuery();  // a BEGIN that never got its END
+    std::memset(sample_counts, 0, sizeof(xenos::xe_gpu_depth_sample_counts));
     if (!BeginGuestOcclusionQuery(sample_count_addr)) {
       return write_fallback_result();
     }
     return true;
   }
 
-  if (!active_occlusion_query_.valid ||
-      active_occlusion_query_.sample_count_address != sample_count_addr) {
-    DisableHostOcclusionQueries();
+  if (!active_occlusion_query_.valid) {
     return write_fallback_result();
   }
 
@@ -2263,6 +2262,17 @@ void D3D12CommandProcessor::OnPrimaryBufferEnd() {
   }
 }
 
+void D3D12CommandProcessor::PrepareForWait() {
+  // Out of guest commands. The guest may be waiting for an occlusion result
+  // (D3D's GetData spins until the GPU writes it), so submit the work it is in
+  // and let OnWaitPoll write it when the GPU is done.
+  if (!pending_occlusion_queries_.empty() && submission_open_) {
+    EndSubmission(false);
+  }
+}
+
+void D3D12CommandProcessor::OnWaitPoll() { WritePendingOcclusionResults(); }
+
 Shader* D3D12CommandProcessor::LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
                                           const uint32_t* host_address, uint32_t dword_count) {
   return pipeline_cache_->LoadShader(shader_type, host_address, dword_count);
@@ -3327,6 +3337,10 @@ bool D3D12CommandProcessor::BeginSubmission(bool is_guest_command) {
     primitive_processor_->BeginSubmission();
 
     texture_cache_->BeginSubmission(submission_current_);
+
+    if (active_occlusion_query_.valid && !active_occlusion_query_.host_open) {
+      BeginOcclusionQuerySegment();
+    }
   }
 
   if (is_opening_frame) {
@@ -3402,11 +3416,9 @@ bool D3D12CommandProcessor::EndSubmission(bool is_swap) {
   if (submission_open_) {
     assert_false(scratch_buffer_used_);
 
-    if (active_occlusion_query_.valid && occlusion_query_heap_) {
-      deferred_command_list_.D3DEndQuery(occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION,
-                                         active_occlusion_query_.host_index);
-      active_occlusion_query_ = {};
-    }
+    // A host query can't span command lists; the guest query continues in a
+    // new segment when the next submission begins.
+    EndOcclusionQuerySegment();
 
     pipeline_cache_->EndSubmission();
 
@@ -4856,7 +4868,9 @@ bool D3D12CommandProcessor::InitializeOcclusionQueryResources() {
 }
 
 void D3D12CommandProcessor::ShutdownOcclusionQueryResources() {
-  DisableHostOcclusionQueries();
+  AbandonActiveOcclusionQuery();
+  pending_occlusion_queries_.clear();
+  occlusion_query_resources_available_ = false;
 
   if (occlusion_query_readback_ && occlusion_query_readback_mapping_) {
     occlusion_query_readback_->Unmap(0, nullptr);
@@ -4874,22 +4888,45 @@ bool D3D12CommandProcessor::AcquireOcclusionQueryIndex(uint32_t& host_index_out)
   return true;
 }
 
-void D3D12CommandProcessor::DisableHostOcclusionQueries() {
-  if (active_occlusion_query_.valid && occlusion_query_heap_) {
-    uint32_t host_index = active_occlusion_query_.host_index;
-    // Clear before EndSubmission to prevent the EndSubmission safety net from issuing a second
-    // EndQuery for the same index.
-    active_occlusion_query_ = {};
-    if (BeginSubmission(true)) {
-      deferred_command_list_.D3DEndQuery(occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION,
-                                         host_index);
-      EndSubmission(false);
-    }
-  } else {
-    active_occlusion_query_ = {};
+void D3D12CommandProcessor::BeginOcclusionQuerySegment() {
+  if (occlusion_query_cursor_ >= kMaxOcclusionQueries) {
+    // A query spanning more submissions than BeginGuestOcclusionQuery reserved
+    // room for: wrapping here could reuse indices whose results haven't been
+    // read back. Drop it; its END then writes the fallback result.
+    AbandonActiveOcclusionQuery();
+    return;
   }
-  occlusion_query_cursor_ = 0;
-  occlusion_query_resources_available_ = false;
+  uint32_t host_index = 0;
+  AcquireOcclusionQueryIndex(host_index);
+  deferred_command_list_.D3DBeginQuery(occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION,
+                                       host_index);
+  active_occlusion_query_.host_index = host_index;
+  active_occlusion_query_.host_open = true;
+}
+
+void D3D12CommandProcessor::EndOcclusionQuerySegment() {
+  if (!active_occlusion_query_.valid || !active_occlusion_query_.host_open ||
+      !occlusion_query_heap_) {
+    return;
+  }
+  uint32_t host_index = active_occlusion_query_.host_index;
+  deferred_command_list_.D3DEndQuery(occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION,
+                                     host_index);
+  deferred_command_list_.D3DResolveQueryData(
+      occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION, host_index, 1,
+      occlusion_query_readback_.Get(), sizeof(uint64_t) * host_index);
+  active_occlusion_query_.ended_segments.push_back(host_index);
+  active_occlusion_query_.host_open = false;
+}
+
+void D3D12CommandProcessor::AbandonActiveOcclusionQuery() {
+  // An open segment means the submission is open too (EndSubmission ends it).
+  if (active_occlusion_query_.valid && active_occlusion_query_.host_open &&
+      occlusion_query_heap_) {
+    deferred_command_list_.D3DEndQuery(occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION,
+                                       active_occlusion_query_.host_index);
+  }
+  active_occlusion_query_ = {};
 }
 
 bool D3D12CommandProcessor::BeginGuestOcclusionQuery(uint32_t sample_count_address) {
@@ -4899,63 +4936,73 @@ bool D3D12CommandProcessor::BeginGuestOcclusionQuery(uint32_t sample_count_addre
   if (active_occlusion_query_.valid) {
     REXGPU_WARN(
         "D3D12CommandProcessor: Occlusion query begin issued while another query is active");
-    DisableHostOcclusionQueries();
+    AbandonActiveOcclusionQuery();
     return false;
   }
 
-  uint32_t host_index = 0;
-  if (!AcquireOcclusionQueryIndex(host_index)) {
-    return false;
+  // Don't let the index cursor wrap onto results still being read back.
+  if (occlusion_query_cursor_ + 64 >= kMaxOcclusionQueries) {
+    if (!pending_occlusion_queries_.empty()) {
+      WritePendingOcclusionResults(pending_occlusion_queries_.back().submission);
+    }
+    occlusion_query_cursor_ = 0;
   }
+
   if (!BeginSubmission(true)) {
     return false;
   }
-
-  deferred_command_list_.D3DBeginQuery(occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION,
-                                       host_index);
+  active_occlusion_query_ = {};
   active_occlusion_query_.sample_count_address = sample_count_address;
-  active_occlusion_query_.host_index = host_index;
   active_occlusion_query_.valid = true;
+  BeginOcclusionQuerySegment();
   return true;
 }
 
 bool D3D12CommandProcessor::EndGuestOcclusionQuery(
     uint32_t sample_count_address, xenos::xe_gpu_depth_sample_counts* sample_counts) {
   if (!REXCVAR_GET(occlusion_query_enable) || !occlusion_query_resources_available_ ||
-      !active_occlusion_query_.valid || !occlusion_query_heap_ || !occlusion_query_readback_) {
+      !active_occlusion_query_.valid || !occlusion_query_heap_ || !occlusion_query_readback_ ||
+      !occlusion_query_readback_mapping_) {
     return false;
   }
-
-  uint32_t host_index = active_occlusion_query_.host_index;
-  active_occlusion_query_ = {};
-
   if (!BeginSubmission(true)) {
+    AbandonActiveOcclusionQuery();
     return false;
   }
-
-  deferred_command_list_.D3DEndQuery(occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION,
-                                     host_index);
-  deferred_command_list_.D3DResolveQueryData(
-      occlusion_query_heap_.Get(), D3D12_QUERY_TYPE_OCCLUSION, host_index, 1,
-      occlusion_query_readback_.Get(), sizeof(uint64_t) * host_index);
-
-  if (!EndSubmission(false)) {
+  if (!active_occlusion_query_.valid) {
+    // Opening the submission couldn't start a segment (out of indices, see
+    // BeginOcclusionQuerySegment) and dropped the query: use the fallback.
     return false;
   }
+  EndOcclusionQuerySegment();
+  pending_occlusion_queries_.push_back(PendingOcclusionQuery{
+      sample_count_address, std::move(active_occlusion_query_.ended_segments),
+      submission_current_});
+  active_occlusion_query_ = {};
+  // The result is written once the GPU has run this submission; until then
+  // the guest's sample count struct keeps D3D's "not finished" marker.
+  WritePendingOcclusionResults();
+  return true;
+}
 
-  uint64_t query_submission = submission_current_ ? submission_current_ - 1 : 0;
-  CheckSubmissionFence(query_submission);
-  if (submission_completed_ < query_submission) {
-    return false;
+void D3D12CommandProcessor::WritePendingOcclusionResults(uint64_t await_submission) {
+  if (pending_occlusion_queries_.empty()) {
+    return;
   }
-  if (!occlusion_query_readback_mapping_) {
-    return false;
+  // Awaiting the open submission ends it first (see CheckSubmissionFence).
+  CheckSubmissionFence(await_submission);
+  while (!pending_occlusion_queries_.empty() &&
+         pending_occlusion_queries_.front().submission <= submission_completed_) {
+    const PendingOcclusionQuery& query = pending_occlusion_queries_.front();
+    uint64_t samples = 0;
+    for (uint32_t host_index : query.host_indices) {
+      samples += occlusion_query_readback_mapping_[host_index];
+    }
+    auto* sample_counts =
+        memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(query.sample_count_address);
+    WriteGuestOcclusionResult(sample_counts, NormalizeOcclusionSamples(samples));
+    pending_occlusion_queries_.pop_front();
   }
-
-  uint64_t samples = occlusion_query_readback_mapping_[host_index];
-  samples = NormalizeOcclusionSamples(samples);
-  WriteGuestOcclusionResult(sample_counts, samples);
-  return true;
 }
 
