index 9605bf1..132deaf 100644
--- a/src/system/CMakeLists.txt
+++ b/src/system/CMakeLists.txt
@@ -14,6 +14,7 @@ set(REXSYSTEM_SOURCES
     xmutant.cpp
     xsemaphore.cpp
     xtimer.cpp
