+// Guest/native query boundaries. Original ReXGlue co-op implementation.
+#include <rex/hook.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/xsocket.h>
+#include <rex/system/xthread.h>
+#if REX_PLATFORM_WIN32
+using socklen_t = int;
+#else
+#include <sys/socket.h>
+#endif
+namespace rex::kernel::xam {
+using namespace rex::system;
+u32 CoopSocketName(u32 handle,ppc_ptr_t<XSOCKADDR_IN> address,mapped_u32 length,bool peer) {
+  auto socket=REX_KERNEL_OBJECTS()->LookupObject<XSocket>(handle);
+  if (!socket) { XThread::SetLastError(10038); return -1; }
+  if (!address || !length || *length<16) { XThread::SetLastError(10014); return -1; }
+  sockaddr_in native{}; socklen_t len=sizeof(native);
+  int ret=peer?getpeername(socket->native_handle(),reinterpret_cast<sockaddr*>(&native),&len):
+               getsockname(socket->native_handle(),reinterpret_cast<sockaddr*>(&native),&len);
+  if (ret<0) {
+#if REX_PLATFORM_WIN32
+    XThread::SetLastError(WSAGetLastError());
+#else
+    XThread::SetLastError(10057);
+#endif
+    return -1;
+  }
+  auto& net=REX_KERNEL_STATE()->coop_network();
+  CoopEndpoint endpoint{ntohl(native.sin_addr.s_addr),ntohs(native.sin_port)};
+  if (peer) endpoint=net.Source(endpoint);
+  else if (socket->bound_port()) endpoint.port=socket->bound_port();
+  address->sin_family=2; address->sin_port=endpoint.port; address->sin_addr=endpoint.ip;
+  std::memset(address->x_sin_zero,0,8); *length=16; return 0;
+}
+u32 NetDll_getsockname_entry(u32 caller,u32 handle,ppc_ptr_t<XSOCKADDR_IN> address,mapped_u32 length) { return CoopSocketName(handle,address,length,false); }
+u32 NetDll_getpeername_entry(u32 caller,u32 handle,ppc_ptr_t<XSOCKADDR_IN> address,mapped_u32 length) { return CoopSocketName(handle,address,length,true); }
+u32 NetDll_getsockopt_entry(u32 caller,u32 handle,u32 level,u32 option,mapped_void value,mapped_u32 length) {
+  auto socket=REX_KERNEL_OBJECTS()->LookupObject<XSocket>(handle);
+  if (!socket) { XThread::SetLastError(10038); return -1; }
+  if (!value || !length || *length<4) { XThread::SetLastError(10014); return -1; }
+  int native_option;
+  if (level!=0xffff) { XThread::SetLastError(10042); return -1; }
+  switch (uint32_t(option)) {
+    case 0x1007: native_option=SO_ERROR; break;
+    case 0x1008: native_option=SO_TYPE; break;
+    case 0x1001: native_option=SO_SNDBUF; break;
+    case 0x1002: native_option=SO_RCVBUF; break;
+    case 0x20: native_option=SO_BROADCAST; break;
+    default: XThread::SetLastError(10042); return -1;
+  }
+  int out=0; socklen_t len=sizeof(out);
+  if (getsockopt(socket->native_handle(),SOL_SOCKET,native_option,reinterpret_cast<char*>(&out),&len)<0) {
+#if REX_PLATFORM_WIN32
+    XThread::SetLastError(WSAGetLastError());
+#else
+    XThread::SetLastError(10022);
+#endif
+    return -1;
+  }
+  memory::store_and_swap<uint32_t>(value,out); *length=4; return 0;
+}
+}
+REX_EXPORT(__imp__NetDll_getsockname,rex::kernel::xam::NetDll_getsockname_entry)
+REX_EXPORT(__imp__NetDll_getpeername,rex::kernel::xam::NetDll_getpeername_entry)
+REX_EXPORT(__imp__NetDll_getsockopt,rex::kernel::xam::NetDll_getsockopt_entry)
