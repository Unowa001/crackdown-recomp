-          ctx.temp(), ctx.v(ctx.insn.operands[1]), ctx.v(ctx.insn.operands[1]),
-          ctx.v(ctx.insn.operands[1]));
+          ctx.temp(), src, src,
+          src);
       ctx.println("\t{}.u32[0] = {}.u32 & 0x3FF;", ctx.v_temp(), ctx.temp());
 
       // Pack y (10 bits, position 10-19) - Guest element 1 is at index 2
       ctx.println(
