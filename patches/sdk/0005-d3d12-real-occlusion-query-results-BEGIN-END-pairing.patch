   bool is_end = is_end_via_z_pass || is_end_via_z_fail;
 
+  // D3D gives BEGIN and END their own sample count structs (seen in
+  // Crackdown: END's is 0x20 bytes before BEGIN's). The GPU writes a snapshot
+  // of the counters into each, and the result is END minus BEGIN. Host
